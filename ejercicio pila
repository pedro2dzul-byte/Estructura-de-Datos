import tkinter as tk

# ---------- Datos ----------
pila = []         
CAPACIDAD = 8     
contador = 1       


# ---------- Funciones ----------
def dibujar(resaltar=False):
    canvas.delete("all")

    # la caja donde se guarda la pila
    canvas.create_line(70, 25, 70, 420, 230, 420, 230, 25, width=4)

    for i in range(len(pila)):
        y2 = 415 - i * 48
        y1 = y2 - 44
        color = "lightblue"
        if resaltar and i == len(pila) - 1:
            color = "orange"
        canvas.create_rectangle(80, y1, 220, y2, fill=color)
        canvas.create_text(150, (y1 + y2) / 2, text=pila[i], font=("Arial", 14))

    if len(pila) > 0:
        y = 415 - (len(pila) - 1) * 48 - 22
        canvas.create_text(265, y, text="<- CIMA", fill="red", font=("Arial", 11, "bold"))
    else:
        canvas.create_text(150, 395, text="(pila vacia)", fill="gray")


def mostrar(texto, color="green", resaltar=False):
    dibujar(resaltar)

    lbl_tamano.config(text="Tamaño: " + str(len(pila)) + " / " + str(CAPACIDAD))
    if len(pila) == 0:
        lbl_vacia.config(text="¿Vacia? Si")
        lbl_cima.config(text="Cima: -")
    else:
        lbl_vacia.config(text="¿Vacia? No")
        lbl_cima.config(text="Cima: " + str(pila[-1]))
    if len(pila) == CAPACIDAD:
        lbl_llena.config(text="¿Llena? Si")
    else:
        lbl_llena.config(text="¿Llena? No")

    lbl_mensaje.config(text=texto, fg=color)
    historial.insert(tk.END, texto)
    historial.see(tk.END)


def apilar(): 
    global contador
    if len(pila) == CAPACIDAD:
        mostrar("Error: la pila esta llena", "red")
        return

    valor = entrada.get()
    if valor == "":
        valor = str(contador)
        contador = contador + 1

    pila.append(valor)
    entrada.delete(0, tk.END)
    mostrar("push(" + valor + ")")


def desapilar():  
    if len(pila) == 0:
        mostrar("Error: la pila esta vacia", "red")
        return

    valor = pila.pop()
    mostrar("pop() -> " + valor)


def ver_cima(): 
    if len(pila) == 0:
        mostrar("Error: la pila esta vacia", "red")
        return

    mostrar("peek() -> " + pila[-1], "green", True)
    ventana.after(1000, dibujar)  


def vaciar():
    global contador
    pila.clear()
    contador = 1
    mostrar("La pila se ha vaciado")


# ---------- Ventana ----------
ventana = tk.Tk()
ventana.title("Pila (LIFO)")

canvas = tk.Canvas(ventana, width=320, height=440, bg="white")
canvas.pack(side="left", padx=10, pady=10)

panel = tk.Frame(ventana)
panel.pack(side="left", padx=10, pady=10)

tk.Label(panel, text="PILA (Stack)", font=("Arial", 16, "bold")).pack()
tk.Label(panel, text="Valor (vacio = automatico):").pack()

entrada = tk.Entry(panel)
entrada.pack(pady=5)

tk.Button(panel, text="Apilar (push)", width=20, command=apilar).pack(pady=2)
tk.Button(panel, text="Desapilar (pop)", width=20, command=desapilar).pack(pady=2)
tk.Button(panel, text="Ver cima (peek)", width=20, command=ver_cima).pack(pady=2)
tk.Button(panel, text="Vaciar pila", width=20, command=vaciar).pack(pady=2)

lbl_tamano = tk.Label(panel)
lbl_tamano.pack()
lbl_vacia = tk.Label(panel)
lbl_vacia.pack()
lbl_llena = tk.Label(panel)
lbl_llena.pack()
lbl_cima = tk.Label(panel)
lbl_cima.pack()

lbl_mensaje = tk.Label(panel, font=("Arial", 10, "bold"))
lbl_mensaje.pack(pady=5)

tk.Label(panel, text="Historial:").pack()
historial = tk.Listbox(panel, width=30, height=8)
historial.pack()

# ---------- Inicio ----------
mostrar("Pila creada")
ventana.mainloop()
